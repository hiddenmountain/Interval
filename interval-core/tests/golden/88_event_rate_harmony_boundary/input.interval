@bpm 120
@ts 4/4
@ppq 480
@seed 1

@scale root=C mode=major

@harmony main
| Cmaj7 Am7 | Dm7 G7 |

@pattern scale_up steps=8 unit=1/8
^1
^3
^5
^7
^1
^3
^5
^7

@track precise ch=1 follow=main vel=80 gate=0.9 oct=4 rate=1.0
play: scale_up * 2

@track shifted ch=2 follow=main vel=80 gate=0.9 oct=4 rate=1.5
play: scale_up * 2

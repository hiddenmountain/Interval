@bpm 120
@ts 4/4
@ppq 480
@seed 1

@scale root=C mode=major

@harmony main
| I | IV | V | I |
section: bar=5 root=G
| I | IV | V | I |

@pattern walk steps=4 unit=1/4
^1
^3
^5
^1

@track normal ch=1 follow=main vel=80 gate=0.9 oct=4
play: walk * 8

@track double ch=2 follow=main vel=80 gate=0.9 oct=4 rate=2.0
play: walk * 8

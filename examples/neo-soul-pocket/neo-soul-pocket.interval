@title "Neo Soul Pocket"
@ppq 480
@bpm 94
@ts 4/4
@seed 2025

@scale root=E mode=dorian

@harmony
im9 | IV13 | bVIImaj7 | im9
im9 | IV13 | bVIImaj7 V7 | im9

@pattern bass_line steps=8 unit=1/8
%1/2
.
%3/2
.
%5/2
.
%4/2
.

@pattern comp_stabs steps=8 unit=1/8
$chord
~
.
%2/4+%4/4
.
$chord
~
.

@pattern lead_cell steps=8 unit=1/8
{^1,^3,^5}
^6
^5
^3
^2
.
^b7
^1/5

@drummap pocket
  kick = 36
  snare = 38
  hh = 42
  ohh = 46

@pattern pocket_beat steps=8 unit=1/8
kick+hh
hh
snare+hh
hh
kick+hh
hh
snare+ohh
hh

@track bass
  ch=1 prog=34 vel=88 gate=0.88 oct=2
  play: bass_line * 4

@track keys
  ch=2 prog=5 vel=74 gate=0.78 oct=4 voice=drop2 inv=auto
  play: comp_stabs * 4 -> agogic(1, 5)

@track lead
  ch=3 prog=81 vel=92 gate=0.82 oct=5
  play: lead_cell * 4 -> phrase(0.58, 0.86)

@track pocketkit
  ch=10 type=drums drummap=pocket vel=104 gate=0.70
  play: pocket_beat * 4 -> humanize(2%, 0.20)

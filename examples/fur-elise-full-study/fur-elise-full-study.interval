@track melody
  ch=1 prog=1 vel=96 gate=0.88
  follow=main
  play: a_theme >> b_theme >> a_theme >> c_theme >> a_theme

@track accompaniment
  ch=2 prog=1 vel=68 gate=0.78 oct=4
  follow=main
  play: broken_bar * 40

@track bass
  ch=3 prog=1 vel=72 gate=0.96 oct=2
  follow=main
  play: bass_bar * 40

@title "Glide Lead Study"
@ppq 480
@bpm 102
@ts 4/4
@seed 7

@scale root=G mode=mixolydian

@harmony main
I7 | bVIImaj7 | IV7 | I7

@pattern lead steps=8 unit=1/8
^1[glide]
^3[glide:0.35]
^5[glide:0.55]
^b7[glide:0.75]
^5
^3[prob:0.85]
^2[glide:0.40]
^1

@pattern bass steps=4 unit=1/4
%1
%1
%3
%4

@track lead
  ch=1 prog=81 vel=96 gate=0.90 oct=5
  follow=main
  play: lead * 4 -> humanize(3%, 0.25)

@track bass
  ch=2 prog=34 vel=84 gate=0.92 oct=2
  follow=main
  play: bass * 4
